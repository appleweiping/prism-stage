{
  "name": "prism-stage",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first motion-to-art studio. Perform once. Reimagine endlessly.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "tsc -b && vitest run",
    "assets": "node scripts/setup-assets.mjs",
    "examples": "tsx scripts/make-examples.ts",
    "test:fixtures": "node scripts/setup-test-fixtures.mjs",
    "test:browser": "node tests/production-browser.mjs",
    "test:media": "node scripts/validate-media.mjs --require-all",
    "test:composite": "node tests/composite-browser.mjs",
    "test:camera": "node tests/camera-composite-browser.mjs",
    "test:composite:smoke": "node tests/composite-release-smoke.mjs",
    "test:composite:media": "node scripts/validate-media.mjs --composite --require-all",
    "release:package": "npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@fontsource-variable/inter": "5.2.8",
    "@mediapipe/tasks-vision": "1.0.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "fake-indexeddb": "6.2.4",
    "playwright": "1.62.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
